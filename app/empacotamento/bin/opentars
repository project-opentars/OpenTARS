#!/bin/bash
# Lançador do openTARS na linha de comando (diagnóstico, --voz, --explicar...). Também atende por "tars".

set -euo pipefail

DIR_OPENTARS="/usr/share/opentars"
VENV_PYTHON="$DIR_OPENTARS/venv/bin/python3"

if [ "${1:-}" = "--setup" ] || [ "${1:-}" = "--configurar" ]; then
    # O setup escreve em /usr/share/opentars, então precisa de root.
    if [ "$(id -u)" -ne 0 ]; then
        # --preserve-env: o sudo zera o ambiente, e o setup precisa de OLLAMA_HOST e das opções TARS_*
        exec sudo --preserve-env=OLLAMA_HOST,TARS_COM_COOPER,TARS_SEM_COOPER,TARS_SEM_GARGANTUA,TARS_MODELO_GARGANTUA,TARS_MODELO_COOPER,TARS_MODELO_CONVERSA,TARS_SEM_MODELO,TARS_IDIOMA bash "$DIR_OPENTARS/setup.sh"
    fi
    exec bash "$DIR_OPENTARS/setup.sh"
fi

# O pyautogui (via python-xlib) aborta na importação se não houver
# arquivo de autorização do X. Em sessões sem ~/.Xauthority e sem
# $XAUTHORITY definido não existe cookie nenhum mesmo, então apontar
# pra um arquivo vazio só evita o crash, sem mudar a permissão de acesso.
if [ -z "${XAUTHORITY:-}" ] && [ ! -f "$HOME/.Xauthority" ]; then
    # GNOME/Wayland: o cookie do XWayland fica em /run/user/<uid>/ (apontar pra /dev/null impede a conexão)
    XAUTH_WAYLAND="$(ls "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/.mutter-Xwaylandauth.* 2>/dev/null | head -n1 || true)"
    export XAUTHORITY="${XAUTH_WAYLAND:-/dev/null}"
fi

if [ -x "$VENV_PYTHON" ]; then
    exec "$VENV_PYTHON" "$DIR_OPENTARS/tars.py" "$@"
else
    exec python3 "$DIR_OPENTARS/tars.py" "$@"
fi
